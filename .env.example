# ───────────────────────────────────────────────────────────────
# Hadhramout Center Platform — environment reference
# Copy to `.env` for local work. On the VPS use deploy/.env.production.example
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Public URL of the site (no trailing slash). Used for canonical/hreflang/OG/sitemaps.
SITE_URL=http://localhost:3000

# Where the SQLite database, uploads and backups live.
DATA_DIR=./data

# REQUIRED in production: long random string (>= 32 chars). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-change-me-in-production

# Set true when running behind Caddy/nginx so client IPs and https are read from X-Forwarded-*
TRUST_PROXY=false

# ── Languages ──────────────────────────────────────────────────
DEFAULT_LANG=ar
# comma list of codes, or * for the whole catalog
ENABLED_LANGS=*
# languages whose COMPLETE translations may be indexed by search engines ("*" = any complete one)
INDEXABLE_LANGS=*

# ── Auto-translation ───────────────────────────────────────────
# none | mock | anthropic | google | libretranslate
TRANSLATION_PROVIDER=none
# languages translated automatically when content is published
TRANSLATION_EAGER_LANGS=en
TRANSLATION_CONCURRENCY=2
# hard daily cap on characters sent to the provider (cost guard)
TRANSLATION_DAILY_CHAR_LIMIT=2000000

ANTHROPIC_API_KEY=
# claude-opus-5-5 (best quality) | claude-sonnet-5-5 (balanced) | claude-haiku-5-5 (cheapest). See docs/05-deploy for the cost table.
TRANSLATION_MODEL=claude-opus-5-5
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# ── First admin (created on first start only if no user exists) ─
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Optional integrations ──────────────────────────────────────
# Cloudflare Turnstile (spam protection for contact/newsletter forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
