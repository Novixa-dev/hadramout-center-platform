# Copy to `.env` for local work. On the VPS use deploy/.env.production.example
PAYLOAD_SECRET=dev-secret-change-me-dev-secret-change-me   # production: openssl rand -hex 32
DATABASE_URL=file:./data/payload.db
DATA_DIR=./data
# MEDIA_DIR=./data/media
SITE_URL=http://localhost:3000

# first admin created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

DEFAULT_LANG=ar
ENABLED_LANGS=*
INDEXABLE_LANGS=ar,en

# none | mock (dev only) | anthropic | google | libretranslate
TRANSLATION_PROVIDER=mock
TRANSLATION_EAGER_LANGS=en
TRANSLATION_CONCURRENCY=2
TRANSLATION_DAILY_CHAR_LIMIT=2000000
TRANSLATION_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# free: Cloudflare Workers AI (TRANSLATION_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-3-12b-it
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# set to 1 to disable the in-process translation worker
PAYLOAD_DISABLE_AUTORUN=0
