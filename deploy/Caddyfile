{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		health_uri /api/hc/health
		health_interval 30s
	}
	header {
		-Server
	}
	log {
		output stdout
		format console
	}
}

