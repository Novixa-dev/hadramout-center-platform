# Copy to /opt/hadramout-center/.env on the VPS and fill in. NEVER commit the real file.
SITE_URL=https://hadramout-center.novixa.dev

# generate: openssl rand -hex 32   (never change after launch)
PAYLOAD_SECRET=

# first admin, created by `docker compose run --rm tools npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEFAULT_LANG=ar
ENABLED_LANGS=*
INDEXABLE_LANGS=ar,en

# none | cloudflare (free) | anthropic | google | libretranslate   ("mock" is rejected in production)
# Free option: run scripts/enable-translation.sh on the server (asks for the Cloudflare Workers AI token)
TRANSLATION_PROVIDER=none
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5
TRANSLATION_EAGER_LANGS=en
TRANSLATION_CONCURRENCY=2
TRANSLATION_DAILY_CHAR_LIMIT=2000000
