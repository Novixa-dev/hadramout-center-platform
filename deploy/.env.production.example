# Copy to /opt/hadramout/.env on the VPS and fill in. NEVER commit the real file.
DOMAIN=hadramout-center.novixa.dev
ACME_EMAIL=you@novixa.dev
SITE_URL=https://hadramout-center.novixa.dev
APP_IMAGE=ghcr.io/novixa-dev/hadramout-center-platform:latest

# generate: openssl rand -hex 32
PAYLOAD_SECRET=

# first admin, created by `docker compose run --rm tools npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEFAULT_LANG=ar
ENABLED_LANGS=*
INDEXABLE_LANGS=ar,en

TRANSLATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5
TRANSLATION_EAGER_LANGS=en
TRANSLATION_CONCURRENCY=2
TRANSLATION_DAILY_CHAR_LIMIT=2000000
